# Chase Ladder environment.
#
# Copy this file to .env and fill in the values by hand. .env is gitignored and
# is never committed. This file carries NAMES ONLY, no values, so that nothing
# in the repository can authenticate to anything.
#
#   cp .env.example .env

# ---- Required ---------------------------------------------------------------

# Shared secret for every HTTP route. Any long random string; the same value
# goes into Mailpit's MP_WEBHOOK_URL query parameter and into the n8n nodes.
CHASE_SHARED_SECRET=

# HubSpot private app token for the demo portal, the pat-<region>-... string.
# Scopes: crm.objects.deals.read, crm.objects.deals.write,
# crm.objects.contacts.read, crm.objects.contacts.write (the seed gives every
# deal an associated contact), crm.schemas.deals.read, and
# crm.schemas.deals.write if the two custom properties and the stage renames
# are done over the API rather than in the portal UI.
HUBSPOT_TOKEN=

# Groq API key. Used only for the step-1 opening line, which falls back to the
# template when the call fails, so the ladder runs without it.
GROQ_API_KEY=

# Telegram chat id for the run alert and the Friday digest. Read by the n8n
# push script; Python never sends Telegram itself.
TELEGRAM_CHAT_ID=

# ---- Optional, defaults shown in brackets ------------------------------------

# Which client YAML in config/ the CLI runs against. [harbourline]
CHASE_CLIENT=

# Demo clock offset, for example 13h or 4d13h. Never a multiplier. [0d]
CHASE_CLOCK_OFFSET=

# Port uvicorn binds. [8000]
CHASE_PORT=

# Mailpit's SMTP port. [1025]
CHASE_SMTP_PORT=

# How old a claimed row must be before the run reports it unresolved. [5m]
CHASE_UNRESOLVED_AFTER=

# Groq model for the opener, so a deprecation is a one-line change.
# [openai/gpt-oss-120b]
CHASE_GROQ_MODEL=

# Mailpit's HTTP API, used by the reply poll at run start.
# [http://localhost:8025]
MAILPIT_URL=

# ---- n8n push script only ----------------------------------------------------

# Left unset, doctor skips its n8n check with a warning instead of failing.
N8N_URL=
N8N_API_KEY=
